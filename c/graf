void graf_set_colour1(vcontext_t *vcx, int action, unsigned int *pattern)
{
    dprintf("Graf_SetColour1: action=%d pattern=%p\n", action, pattern);

    vcx->action1 = action;
    if (pattern)
        memcpy(vcx->pattern1, pattern, sizeof(vcx->pattern1));

    /* Store the primary drawing colour pattern.
     * The pattern is an 8-word block (for ECFs).
     * 'action' defines how the colour is applied (e.g., OR, EOR).
     */
}

