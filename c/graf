void graf_circle_fill(vcontext_t *vcx, int xc, int yc, int xe, int ye, int colour_op, graphicscontext_t *context)
{
    int dx, dy, r_sq;
    int y, rem;
    int x_off;
    int bit, res;

    dprintf("Graf_CircleFill: centre(%d,%d) edge(%d,%d) colour_op=%d context=%p\n",
            xc, yc, xe, ye, colour_op, context);

    dx = xe - xc;
    dy = ye - yc;
    r_sq = dx * dx + dy * dy;

    if (r_sq <= 0)
        return;

    dprintf("  radius^2=%d\n", r_sq);

    /* Fill each scan line using the circle equation:
     * x_offset = floor(sqrt(r_sq - y^2))
     * Uses integer-only square root (bit-shift method).
     */
    for (y = 0; ; y++)
    {
        rem = r_sq - y * y;
        if (rem < 0)
            break;

        /* Integer square root of rem (bit-shift method) */
        res = 0;
        bit = 1 << 14;
        while (bit > rem)
            bit >>= 2;
        while (bit != 0)
        {
            if (rem >= res + bit)
            {
                rem -= res + bit;
                res = (res >> 1) + bit;
            }
            else
            {
                res >>= 1;
            }
            bit >>= 2;
        }
        x_off = res;

        context_hline_bounded(xc - x_off, yc + y, xc + x_off, colour_op, context);
        if (y != 0)
            context_hline_bounded(xc - x_off, yc - y, xc + x_off, colour_op, context);
    }
}

