void graf_change_destination(vcontext_t *vcx, int *block, int is_sprite)
{
    dprintf("Graf_ChangeDestination: vcx=%p block=%p is_sprite=%d\n", vcx, block, is_sprite);

    if (vcx == NULL)
        return;

    if (block)
    {
        dprintf("  modeflags=%d width=%d height=%d log2bpp=%d xeig=%d yeig=%d\n",
                block[0], block[1] + 1, block[2] + 1, block[3], block[4], block[5]);
        dprintf("  base=%p rowstride=%d\n", (void *)block[6], block[7]);
    }

    /* Update context from information block:
     * block[0]: Mode flags
     * block[1]: Width - 1 (pixels)
     * block[2]: Height - 1 (pixels)
     * block[3]: Log2BPP
     * block[4]: XEig
     * block[5]: YEig
     * block[6]: Base address
     * block[7]: Row stride (bytes)
     */
    vcx->modeflags = block[0];
    vcx->scrwidth = block[1] + 1;
    vcx->scrheight = block[2] + 1;
    vcx->log2bpp = block[3];
    vcx->scrxeig = block[4];
    vcx->scryeig = block[5];
    vcx->base = (void *)block[6];
    vcx->linelength = block[7];

    /* This prepares the graphics driver for drawing to a new destination.
     * If is_sprite is non-zero, redirection is to a sprite.
     */
}

