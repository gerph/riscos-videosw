void graf_poly_hline(vcontext_t *vcx, void *buffer, int colour_op, graphicscontext_t *context)
{
    int32_t clip_x0, clip_x1, clip_y0, clip_y1;
    int32_t *buf = (int32_t *)buffer;
    int32_t count, x0, y, x1;
    int32_t bx0, bx1;
    int i;

    dprintf("Graf_PolyHLine: buffer=%p colour_op=%d context=%p\n", buffer, colour_op, context);

    if (context == NULL || buffer == NULL)
        return;

    count = buf[0];

    clip_x0 = context->clip_x0;
    clip_x1 = context->clip_x1;
    clip_y0 = context->clip_y0;
    clip_y1 = context->clip_y1;

    dprintf("  clip rect: (%d,%d)-(%d,%d) count=%d\n", clip_x0, clip_y0, clip_x1, clip_y1, count);

    for (i = 0; i < count; i++)
    {
        int32_t *entry = buf + 1 + (i * 3);
        x0 = entry[0];
        y  = entry[1];
        x1 = entry[2];

        /* Reject line outside clip in Y */
        if (y < clip_y0 || y >= clip_y1)
            continue;

        /* Bound X coordinates to clip rectangle */
        bx0 = x0;
        if (bx0 < clip_x0)
            bx0 = clip_x0;
        bx1 = x1;
        if (bx1 > clip_x1)
            bx1 = clip_x1;

        /* Reject if nothing visible after bounding */
        if (bx0 >= bx1)
            continue;

        dprintf("  line %d: (%d,%d)-(%d,%d) bounded to (%d,%d)-(%d,%d)\n",
                i, x0, y, x1, y, bx0, y, bx1, y);

        context_hline(bx0, y, bx1, colour_op, context);
    }
}
