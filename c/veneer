/* Our teletext context */
typedef struct vcontext_s {
  int scrwidth, scrheight;
  int textwidth, textheight;
  int scrxeig, scryeig;
  int charx, chary;
  int cursorx, cursory, cursorcx, cursorcy;
} vcontext_t;

static int maxvcx = 0;
static vcontext_t *vcxd = NULL;

#define STATE_FLASH (1<<0)

/*************************************************** Gerph *********
 Function:     vcxd_find
 Description:  Find the context structure for a given display
 Parameters:   display = the display number
 Returns:      pointer to video context structure, or NULL if cannot allocate
 ******************************************************************/
vcontext_t *vcxd_find(int display)
{
  vcontext_t *newvcxd;
  if (display < 0)
    return NULL;

  if (display < maxvcx)
    return &vcxd[display];

  /* Lazy extension by 2 entries at a time */
  while (display >= maxvcx)
  {
    newvcxd = realloc(vcxd, sizeof(vcontext_t) * (maxvcx+2));
    if (newvcxd == NULL)
      return NULL; /* Cannot allocate - give up */

    /* Zero the new entries */
    memset(&newvcxd[maxvcx], 0, sizeof(vcontext_t));
    memset(&newvcxd[maxvcx+1], 0, sizeof(vcontext_t));

    vcxd = newvcxd;
    maxvcx+=2;
  }

  return &vcxd[display];
}

/***************************************************************************
 * Function:     Mod_Init
 * Description:  Initialise the module, setting up vectors, callbacks and
 *               any other parts of the system necessary for the module to
 *               function.
 * Parameters:   tail        = pointer to command line (control terminated)
 *               podule_base = address of podule module was started from, or
 *                             NULL if none
 *               pw          = private word for module
 * On exit:      Return NULL for successful initialisation, or a pointer to
 *               an error block if the module could not start properly.
 **************************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
  unsigned long flags;
  _kernel_oserror *err;

  err = _swix(OS_Claim, _INR(0,2), VideoV, videov_entry, pw);

  return err;
}


/***************************************************************************
 * Function:     Mod_Final
 * Description:  Finalise the module, shutting down any systems necessary,
 *               freeing vectors and releasing workspace
 * Parameters:   fatal       = fatality indicator; 1 if fatal, 0 if
 *                             reinitialising
 *               podule_base = address of podule module was started from, or
 *                             NULL if none
 *               pw          = private word for module
 * On exit:      Return 0 for successful finalisation, or a pointer to an
 *               error block if module was not shutdown properly.
 **************************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
  int display;

  _swix(OS_Release, _INR(0,2), VideoV, videov_entry, pw);

  for (display=0; display<maxvcx; display++)
  {
    vcontext_t *vcx = &vcxd[display];
    /* Destroy any other contexts */
  }
  free(vcxd);
  return NULL;
}


