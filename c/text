    dprintf("Text_ClearBox: vcx=%p xmin=%d ymin=%d xmax=%d ymax=%d base=%p linelength=%d log2bpp=%d modeflags=%d\n",
            vcx, xmin, ymin, xmax, ymax, base, linelength, log2bpp, modeflags);

    if (vcx == NULL)
        return;

    /* Clear a rectangular region of the screen for text.
     * The region is defined by (xmin, ymin) to (xmax, ymax) in text coordinates.
     * The area should be filled with the current background colour.
     */
}
