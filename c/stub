/*************************************************** Gerph *********
 Function:     context_hline_bounded
 Description:  Draw a horizontal line bounded to the clipping rectangle
 Parameters:   x1         = start x coordinate
               y          = y coordinate
               x2         = end x coordinate
               colour_op  = colour operation
               context    = pointer to graphics context containing clip
 Returns:      none
 ******************************************************************/
void context_hline_bounded(int x1, int y, int x2, uint32_t colour_op, graphicscontext_t *gcx)
{
    int32_t rx0, ry0, rx1, ry1;
    int32_t nx1, nx2;

    if (gcx == NULL)
        return;

    rx0 = gcx->clip_x0;
    ry0 = gcx->clip_y0;
    rx1 = gcx->clip_x1;
    ry1 = gcx->clip_y1;

    if (y < ry0 || y >= ry1)
        return;

    nx1 = x1;
    if (nx1 < rx0)
        nx1 = rx0;
    nx2 = x2;
    if (nx2 > rx1)
        nx2 = rx1;

    if (nx1 >= nx2)
        return;
}

