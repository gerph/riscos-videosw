/*************************************************** Gerph *********
 Function:     context_point_bounded
 Description:  Plot a point bounded to the clipping rectangle
 Parameters:   x          = x coordinate
               y          = y coordinate
               colour_op  = colour operation
               context    = pointer to graphics context containing clip
 Returns:      none
 ******************************************************************/
void context_point_bounded(int x, int y, uint32_t colour_op, graphicscontext_t *gcx)
{
    int32_t rx0, ry0, rx1, ry1;

    if (gcx == NULL)
        return;

    rx0 = gcx->clip_x0;
    ry0 = gcx->clip_y0;
    rx1 = gcx->clip_x1;
    ry1 = gcx->clip_y1;

    if (x < rx0 || x >= rx1)
        return;
    if (y < ry0 || y >= ry1)
        return;
}

