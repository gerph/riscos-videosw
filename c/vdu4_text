#include "vdu4_text.h"

void vdu4_tables_build_plain(vdu4_state_t *state, uint32_t bpp);
void vdu4_tables_build_coloured(vdu4_state_t *state,
                                uint32_t bpp,
                                uint32_t foreground,
                                uint32_t background);

static vdu4_plot_routine_t vdu4_select_text_routine(uint32_t log2_bpap, uint32_t mode_flags)
{
    if ((mode_flags & VDU4_FLAG_DOUBLE_VERTICAL) != 0 && log2_bpap == 0)
    {
        return VDU4_PLOT_ROUTINE_1BPP_DOUBLE;
    }

    switch (log2_bpap)
    {
        case 0:
            return VDU4_PLOT_ROUTINE_1BPP;
        case 1:
            return VDU4_PLOT_ROUTINE_2BPP;
        case 2:
            return VDU4_PLOT_ROUTINE_4BPP;
        case 3:
            return VDU4_PLOT_ROUTINE_8BPP;
        case 4:
            return VDU4_PLOT_ROUTINE_16BPP;
        case 5:
            return VDU4_PLOT_ROUTINE_32BPP;
        default:
            return VDU4_PLOT_ROUTINE_1BPP;
    }
}

static uint32_t vdu4_cursor_fill_value(uint32_t log2_bpap, uint32_t mode_flags)
{
    uint32_t value;

    if ((mode_flags & VDU4_FLAG_BBC_GAP_MODE) != 0)
    {
        value = 0x55u;
    }
    else if (log2_bpap == 2)
    {
        value = 0x77u;
    }
    else
    {
        value = 0xFFu;
    }

    value |= value << 8;
    value |= value << 16;

    return value;
}

static void vdu4_plot_row(vdu4_state_t *state, uint8_t *screen, uint8_t row_byte)
{
    uint32_t bpp;
    uint8_t *table;

    bpp = vdu4_state_bits_per_pixel(state->destination.log2_bpap);
    table = state->text_expand_area + row_byte * bpp;

    switch (bpp)
    {
        case 1:
            screen[0] = table[0];
            break;

        case 2:
            screen[0] = table[0];
            screen[1] = table[1];
            break;

        case 4:
            ((uint32_t *)screen)[0] = ((const uint32_t *)table)[0];
            break;

        case 8:
            ((uint32_t *)screen)[0] = ((const uint32_t *)table)[0];
            ((uint32_t *)screen)[1] = ((const uint32_t *)table)[1];
            break;

        case 16:
            ((uint32_t *)screen)[0] = ((const uint32_t *)table)[0];
            ((uint32_t *)screen)[1] = ((const uint32_t *)table)[1];
            ((uint32_t *)screen)[2] = ((const uint32_t *)table)[2];
            ((uint32_t *)screen)[3] = ((const uint32_t *)table)[3];
            break;

        case 32:
            ((uint32_t *)screen)[0] = ((const uint32_t *)table)[0];
            ((uint32_t *)screen)[1] = ((const uint32_t *)table)[1];
            ((uint32_t *)screen)[2] = ((const uint32_t *)table)[2];
            ((uint32_t *)screen)[3] = ((const uint32_t *)table)[3];
            ((uint32_t *)screen)[4] = ((const uint32_t *)table)[4];
            ((uint32_t *)screen)[5] = ((const uint32_t *)table)[5];
            ((uint32_t *)screen)[6] = ((const uint32_t *)table)[6];
            ((uint32_t *)screen)[7] = ((const uint32_t *)table)[7];
            break;
    }
}

/*******************************************************************
 Function:      vdu4_change_destination
 Description:   Cache text destination properties and rebuild text tables
 Parameters:    state = renderer state
                screen_start = base of output buffer
                line_length = byte stride between rows
                scr_brow = maximum text row index
                log2_bpap = Log2 Bits Per Addressable Pixel
                mode_flags = VideoV mode flags
 Returns:       none
 ******************************************************************/
void vdu4_change_destination(vdu4_state_t *state,
                             uint8_t *screen_start,
                             uint32_t line_length,
                             uint32_t scr_brow,
                             uint32_t log2_bpap,
                             uint32_t mode_flags)
{
    uint32_t bpp;

    state->destination.screen_start = screen_start;
    state->destination.line_length = line_length;
    state->destination.scr_brow = scr_brow;
    state->destination.log2_bpap = log2_bpap;
    state->destination.mode_flags = mode_flags;

    state->text_char_routine = vdu4_select_text_routine(log2_bpap, mode_flags);
    state->text_cursor_routine = vdu4_select_text_routine(log2_bpap, 0);
    state->cursor_fill = vdu4_cursor_fill_value(log2_bpap, mode_flags);

    bpp = vdu4_state_bits_per_pixel(log2_bpap);
    vdu4_tables_build_plain(state, bpp);
}

/*******************************************************************
 Function:      vdu4_set_colour
 Description:   Cache text colours and rebuild the row expansion table
 Parameters:    state = renderer state
                foreground = pixel value for set bits
                background = pixel value for clear bits
                bpp = bits per pixel
 Returns:       none
 ******************************************************************/
void vdu4_set_colour(vdu4_state_t *state,
                     uint32_t foreground,
                     uint32_t background,
                     uint32_t bpp)
{
    state->text_fg_colour = vdu4_state_expand_colour(foreground, bpp);
    state->text_bg_colour = vdu4_state_expand_colour(background, bpp);
    vdu4_tables_build_coloured(state, bpp, foreground, background);
}

/*******************************************************************
 Function:      vdu4_plot_char
 Description:   Render a soft font character to the supplied destination
 Parameters:    state = renderer state
                ch = character code to plot
                screen = destination address of the top-left pixel
                char_x = character x position, for compatibility
                char_y = character y position, for compatibility
 Returns:       none
 ******************************************************************/
void vdu4_plot_char(vdu4_state_t *state,
                    uint32_t ch,
                    uint8_t *screen,
                    uint32_t char_x,
                    uint32_t char_y)
{
    int index;
    const uint8_t *glyph;
    uint32_t row;
    uint8_t *cursor;

    (void)char_x;
    (void)char_y;

    index = vdu4_state_char_index(ch);
    if (index < 0)
    {
        return;
    }

    glyph = state->soft_font[index];
    cursor = screen;

    for (row = 0; row < 8; row++)
    {
        vdu4_plot_row(state, cursor, glyph[row]);
        cursor += state->destination.line_length;

        if (state->text_char_routine == VDU4_PLOT_ROUTINE_1BPP_DOUBLE)
        {
            vdu4_plot_row(state, cursor, glyph[row]);
            cursor += state->destination.line_length;
        }
    }
}
