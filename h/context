#ifndef CONTEXT_H
#define CONTEXT_H

#include <stdint.h>

/* Our video context */
typedef struct vcontext_s
{
    void *base;
    int linelength;
    int log2bpp;
    int modeflags;

    int scrwidth, scrheight;
    int textwidth, textheight;
    int scrxeig, scryeig;
    int charx, chary;
    int cursorx, cursory, cursorcx, cursorcy;

    int fg_colour, bg_colour;
    int action1, action2;
    unsigned int pattern1[8], pattern2[8];
} vcontext_t;


typedef struct graphicscontext_s {
    int32_t clip_x0;    /* Graphics clipping window x-min (inclusive) */
    int32_t clip_y0;    /* Graphics clipping window y-min (inclusive) */
    int32_t clip_x1;    /* Graphics clipping window x-max (exclusive) */
    int32_t clip_y1;    /* Graphics clipping window y-max (exclusive) */
    uint32_t func_hline_bounded;    /* Function to call to render a bounded horizontal line */
    uint32_t func_hline_unbounded;  /* Function to call to render a unbounded horizontal line */
    uint32_t func_point_bounded;    /* Function to call to render a bounded point */
    uint32_t func_point_unbounded;  /* Function to call to render a unbounded point */
} graphicscontext_t;

/*************************************************** Gerph *********
 Function:      vcxd_final
 Description:   Shutdown the Video Context Display information
 Parameters:    none
 Returns:       none
 ******************************************************************/
void vcxd_final(void);

/*************************************************** Gerph *********
 Function:     vcxd_find
 Description:  Find the context structure for a given display
 Parameters:   display = the display number
 Returns:      pointer to video context structure, or NULL if cannot allocate
 ******************************************************************/
vcontext_t *vcxd_find(int display);

#endif
